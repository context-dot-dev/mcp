{
  "name": "context-mcp",
  "type": "module",
  "version": "1.0.0",
  "description": "Live web and document context for AI agents",
  "author": "Context",
  "license": "MIT",
  "keywords": [
    "mcp",
    "server",
    "context",
    "web-scraping",
    "document-parsing",
    "batch-scraping",
    "monitoring",
    "oauth"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "generate:endpoints": "tsx scripts/generate-context-endpoints.ts",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 src/*.test.ts",
    "postinstall": "mcp-use generate-types || exit 0"
  },
  "dependencies": {
    "@openai/apps-sdk-ui": "^0.2.2",
    "hono": "4.12.34",
    "jose": "6.2.4",
    "mcp-use": "2.11.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.18.2",
    "tailwindcss": "^4.2.0",
    "undici": "7.30.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "lodash": "4.18.1",
    "nanoid": "3.3.17",
    "posthog-js": "1.407.5",
    "protobufjs": "7.6.5",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2"
  }
}
