# Reference only: export these variables or configure your environment loader.
# Never commit real credentials.

# Private local development. Leave unset to require caller-supplied credentials.
# CONTEXT_API_KEY=your-context-api-key
CONTEXT_API_BASE=https://api.context.dev/v1
MCP_URL=http://localhost:3000

# Public deployments: configure all three OAuth secrets together.
# See docs/deployment.md. Never expose a shared fallback API key publicly.
# CONTEXT_OAUTH_ISSUER=https://www.context.dev
# CONTEXT_OAUTH_CLIENT_ID=your-registered-client-id
# CONTEXT_OAUTH_CLIENT_SECRET=your-registered-client-secret
# CONTEXT_OAUTH_TOKEN_ENCRYPTION_KEY=your-base64url-encoded-32-byte-key
